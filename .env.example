# Copy to `.env` and fill in. All VITE_* vars are exposed to the client bundle,
# so put ONLY public keys here (the Supabase anon key is fine; RLS is the real
# security boundary). Never put the Supabase service key in a VITE_ var.

# --- Map tiles (SPEC §8.1) ---------------------------------------------------
# Leave unset in local dev to use public OSM tiles (dev only).
# For any deployed build, set these to a provider or a self-hosted .pmtiles URL.
#
# The provider is swappable via these vars alone (see src/map/tileSource.ts).
#
# MapTiler example (restrict the key to your domain in the MapTiler dashboard):
#   VITE_TILE_URL=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png
#   VITE_TILE_API_KEY=your_maptiler_key
#   VITE_TILE_ATTRIBUTION=&copy; <a href="https://www.maptiler.com/copyright/">MapTiler</a> &copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
#
# Stadia Maps example:
#   VITE_TILE_URL=https://tiles.stadiamaps.com/tiles/osm_bright/{z}/{x}/{y}.png
#   VITE_TILE_API_KEY=your_stadia_key
VITE_TILE_URL=
VITE_TILE_KIND=raster
VITE_TILE_API_KEY=
VITE_TILE_ATTRIBUTION=

# Base path for the built app. Leave unset locally ("/"); CI sets it to
# "/<repo>/" for GitHub Pages project sites.
# VITE_BASE=/StallOrigins/

# --- Supabase (Phase 2+) -----------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
